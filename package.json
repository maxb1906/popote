{
  "name": "popote",
  "version": "1.0.0",
  "description": "Free, open-source, offline recipe notebook: import recipes from links and text, cook step by step, plan the week, get the shopping list.",
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "contrast": "node scripts/contrast.mjs design/tokens.json",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/replica/"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.70.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "private": true
}
